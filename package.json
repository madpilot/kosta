{
  "name": "garden-agent",
  "version": "1.0.0",
  "description": "Gardening assistant with AI-powered calendar and advice",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gardening",
    "ai",
    "calendar"
  ],
  "license": "MIT",
  "dependencies": {
    "@orpc/contract": "^1.14.0",
    "@orpc/openapi": "^1.14.0",
    "@orpc/server": "^1.14.0",
    "@orpc/standard-server-node": "^1.14.0",
    "@orpc/zod": "^1.14.0",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "ollama": "^0.5.12",
    "uuid": "^11.0.4",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
