# Server
PORT=3000
HOST=0.0.0.0

# Public-facing base URL — used in password-reset emails and any other
# outbound link generation. No trailing slash.
APP_BASE_URL=http://localhost:3000

# Database (default: ./data/garden.db)
DATABASE_URL=

# AI Backend: 'ollama' (default) or 'openai'
AI_BACKEND=ollama

# Ollama (used when AI_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (used when AI_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Custom system preamble (optional — overrides the default Costa prompt)
AI_PREAMBLE=

# Weather forecast — OpenWeatherMap API key (https://openweathermap.org/api)
WEATHER_API_KEY=

# User location and hemisphere (used in system prompt + season detection)
# e.g. USER_LOCATION="Perth, AU"
USER_LOCATION=
USER_HEMISPHERE=southern

# Logging
# Standard npm levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
# 'pretty' (colourised, human readable) or 'json' (line-delimited for log shippers)
LOG_FORMAT=pretty
# Silence all output. Auto-true under NODE_ENV=test.
LOG_SILENT=false
