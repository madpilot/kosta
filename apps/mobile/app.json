{
  "expo": {
    "name": "Sprout",
    "slug": "sprout",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "sprout",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.madpilot.sprout"
    },
    "android": {
      "package": "com.madpilot.sprout",
      "adaptiveIcon": {
        "backgroundColor": "#163528"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
